<!DOCTYPE html>
<html>
<<meta name="viewport" content="width=device-width, initial-scale=1.0">
><title>Register Account</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
    <div class="container" style="max-width:400px; margin-top:50px;">
        <h2>Create Mwareshop Account</h2>
        <% if(error){ %><p style="color:red;"><%= error %></p><% } %>
        <form action="/customer/register" method="POST" style="max-width:100%;">
            <label>Full Name</label><input type="text" name="name" required>
            <label>Phone Number</label><input type="text" name="phone" required>
            <label>Email Address</label><input type="email" name="email" required>
            <label>Secure Password</label><input type="password" name="password" required>
            <button type="submit">Register Account</button>
        </form>
        <p><a href="/customer/login">Already have an account? Log In</a></p>
    </div>
</body>
</html>

