<!DOCTYPE html>
<html>
<<meta name="viewport" content="width=device-width, initial-scale=1.0">
>
    <title>Admin Dashboard - Mwareshop</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <h1>Mwareshop Administrative Control Panel</h1>
        
        <nav style="display: flex; justify-content: space-between; align-items: center;">
            <div>
                <a href="/">🌐 View Storefront</a>
                <a href="/contact">📞 View Contact Page</a>
            </div>
            <div>
                <a href="/logout" style="color: #f87171; font-weight: bold; text-decoration: none;">🚪 Secure Log Out</a>
            </div>
        </nav>

        <!-- QR CODE INVITATION WIDGET BLOCK -->
        <div style="background: #ffffff; border: 1px solid #e2e8f0; padding: 20px; border-radius: 12px; display: flex; align-items: center; gap: 30px; margin-bottom: 30px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
            <div>
                <img src="<%= shopQrCode %>" alt="Shop Invite QR" style="border: 2px solid #1e293b; border-radius: 8px; display: block; max-width: 150px;">
            </div>
            <div>
                <h2 style="margin:0 0 10px 0;">📲 Shop Invitation QR Code</h2>
                <p style="margin: 0 0 15px 0; color: #475569; max-width: 600px;">This QR code updates automatically to match your site address. Display this image or print it out so people can instantly scan and visit **Mwareshop** on their mobile phones!</p>
                <a href="<%= shopQrCode %>" download="mwareshop-invite-qr.png" style="background: #1e293b; color: white; text-decoration: none; padding: 8px 16px; border-radius: 6px; font-weight: 600; font-size: 13px; display: inline-block;">📥 Download QR Image</a>
            </div>
        </div>

        <!-- 1. SALES ORDER LIFECYCLE TRACKER -->
        <h2>🚨 Active Order Notifications</h2>
        <table>
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>Customer Name</th>
                    <th>Contact Phone</th>
                    <th>Items Summary</th>
                    <th>Grand Total</th>
                    <th>Status Tracker</th>
                    <th>Operations Management</th>
                </tr>
            </thead>
            <tbody>
                <% if (orders && orders.length > 0) { %>
                    <% orders.forEach(order => { %>
                        <tr>
                            <td>#<%= order.id %></td>
                            <td><strong><%= order.name %></strong></td>
                            <td><a href="tel:<%= order.phone %>" style="color: #2563eb; text-decoration: none;"><%= order.phone %></a></td>
                            <td><%= order.items_summary %></td>
                            <td style="color: #10b981; font-weight: bold;"><%= info.currency %><%= order.total_price.toFixed(2) %></td>
                            <td>
                                <% if (order.status === 'Pending') { %>
                                    <span style="color: #d97706; background: #fef3c7; padding: 4px 8px; border-radius: 4px; font-weight: bold; font-size: 13px;">⏳ Pending Approval</span>
                                <% } else if (order.status === 'Confirmed (Sold)') { %>
                                    <span style="color: #2563eb; background: #dbeafe; padding: 4px 8px; border-radius: 4px; font-weight: bold; font-size: 13px;">🚢 Shipped / Sold</span>
                                <% } else { %>
                                    <span style="color: #10b981; background: #d1fae5; padding: 4px 8px; border-radius: 4px; font-weight: bold; font-size: 13px;">🤝 Fully Completed</span>
                                <% } %>
                            </td>
                            <td>
                                <% if (order.status === 'Pending') { %>
                                    <form action="/admin/confirm-sale/<%= order.id %>" method="POST" style="padding:0; border:0; margin:0; max-width: 100%;">
                                        <button type="submit" style="background-color: #2563eb; padding: 6px 12px; font-size: 12px; width: auto;">
                                            ✅ Confirm Sale & Ship
                                        </button>
                                    </form>
                                <% } else if (order.status === 'Confirmed (Sold)') { %>
                                    <span style="color: #64748b; font-size: 13px; font-style: italic;">Awaiting customer receipt</span>
                                <% } else { %>
                                    <span style="color: #10b981; font-weight: bold; font-size: 13px;">Transaction Finalised</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="7" style="text-align: center; color: #64748b;">No customer orders placed yet.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>

        <!-- 2. INVENTORY STOCK MANAGEMENT -->
        <h2>📦 Product Inventory Control</h2>
        <table>
            <thead>
                <tr>
                    <th>Product Showcase</th>
                    <th>Product Title</th>
                    <th>Base Price</th>
                    <th>Current Status</th>
                    <th>Stock Toggle Operation</th>
                    <th>Remove Listing</th>
                </tr>
            </thead>
            <tbody>
                <% if (products && products.length > 0) { %>
                    <% products.forEach(product => { %>
                        <tr>
                            <td style="width: 80px;">
                                <% if (product.image) { %>
                                    <img src="<%= product.image %>" style="width: 60px; height: 40px; object-fit: cover; border-radius: 4px; margin: 0;">
                                <% } else { %>
                                    <span style="color: #cbd5e1; font-size: 12px;">No Image</span>
                                <% } %>
                            </td>
                            <td><strong><%= product.title %></strong></td>
                            <td><%= info.currency %><%= product.price.toFixed(2) %></td>
                            <td><%= product.in_stock === 1 ? '🟢 In Stock Available' : '🔴 Out of Stock' %></td>
                            <td>
                                <form action="/admin/toggle-stock/<%= product.id %>" method="POST" style="padding:0; border:0; margin:0; max-width: 100%;">
                                    <input type="hidden" name="current_stock" value="<%= product.in_stock %>">
                                    <button type="submit" style="background-color: #475569; padding: 6px 12px; width: auto; font-size: 12px;">
                                        Switch Availability
                                    </button>
                                </form>
                            </td>
                            <td>
                                <form action="/admin/delete-product/<%= product.id %>" method="POST" style="padding:0; border:0; margin:0; max-width: 100%;" onsubmit="return confirm('Delete this product permanently?');">
                                    <button type="submit" style="background-color: #ef4444; padding: 6px 12px; width: auto; font-size: 12px;">
                                        🗑️ Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr><td colspan="6" style="text-align: center; color: #64748b;">No products found.</td></tr>
                <% } %>
            </tbody>
        </table>

        <!-- 3. CONFIGURATION FORMS CONTAINER -->
        <div style="display: flex; gap: 40px; flex-wrap: wrap; margin-top: 40px;">
            <div style="flex: 1; min-width: 320px;">
                <h2>➕ Add New Store Product</h2>
                <form action="/admin/add-product" method="POST" enctype="multipart/form-data">
                    <label>Product Title:</label>
                    <input type="text" name="title" required>
                    
                    <label>Product Price:</label>
                    <input type="number" step="0.01" name="price" required>
                    
                    <label>Description:</label>
                    <textarea name="description" rows="4" required></textarea>
                    
                    <label>Display Image:</label>
                    <input type="file" name="image" accept="image/*" required>
                    
                    <button type="submit" style="background-color: #10b981; margin-top: 10px;">Publish Product Live</button>
                </form>
            </div>

            <div style="flex: 1; min-width: 320px;">
                <h2>📞 Edit Store Contact Settings</h2>
                <form action="/admin/update-contact" method="POST">
                    <label>Store Email:</label>
                    <input type="email" name="email" value="<%= info.email %>" required>
                    
                    <label>Support Phone:</label>
                    <input type="text" name="phone" value="<%= info.phone %>" required>
                    
                    <label>Headquarters Address:</label>
                    <input type="text" name="address" value="<%= info.address %>" required>
                    
                    <label>Store Base Currency:</label>
                    <select name="currency" style="width: 100%; padding: 10px; margin: 8px 0 15px 0; border: 1px solid #cbd5e1; border-radius: 6px; background: #fff; font-family: inherit;">
<option value="$" <%= info.currency === '$' ? 'selected' : '' %>>USD ($)<option value="KSh" <%= info.currency === 'KSh' ? 'selected' : '' %>>KES (KSh)<option value="€" <%= info.currency === '€' ? 'selected' : '' %>>EUR (€)<option value="£" <%= info.currency === '£' ? 'selected' : '' %>>GBP (£)Update Settings🔒 Admin Password SettingsNew Password:Confirm Password: Show TextApply Passwordfunction toggleAdminPass() {var p1 = document.getElementById("newPass");var p2 = document.getElementById("confirmPass");var typeState = p1.type === "password" ? "text" : "password";p1.type = typeState;p2.type = typeState;}
